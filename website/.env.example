# Local development — point website at your running backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Web client ID (must also be listed in backend GOOGLE_CLIENT_ID or GOOGLE_CLIENT_IDS)
# Create a Web application OAuth client in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173  http://127.0.0.1:5173
# Authorized redirect URIs: http://localhost:5173  http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=

# Production example (only when deploying the website):
# VITE_API_BASE_URL=https://your-backend.vercel.app
