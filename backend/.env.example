# Local developer template. Keep real local credentials in backend/.env or
# backend/.env.local (both are git-ignored); do not deploy those files.
# Production values belong in the hosting provider's runtime environment.
# SnapDeploy's managed MySQL add-on supplies MYSQL_URL; the backend supports it.
# Default database = MySQL, database name = novel_app_db_v2
ENV=development
DEBUG=true
DB_TYPE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db
MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql
MYSQL_FALLBACK_SQLITE=false

UPLOAD_DIR=./uploads
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_EXPIRES_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Database startup runs safe migrations and idempotent catalog/demo seeds by default.
# Destructive reset dumps and account-unlock scripts remain manual to protect data.
AUTO_RUN_DB_MIGRATIONS=true
AUTO_RUN_INKITT_SEED=true
# ENABLE_INKITT_SEED=1
# Generated catalog chapters/reviews run automatically on local backend starts.
# Set false to skip locally; set true explicitly to enable on serverless deployments.
# RUN_CONTENT_ENRICHMENT=false
# FORCE_SCHEMA_ENSURES=1
