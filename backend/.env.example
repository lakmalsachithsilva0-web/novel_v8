# # Default database = MySQL, database name = novel_app_db_v2
# ENV=development
# DEBUG=true
# DB_TYPE=mysql

# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password_here
# MYSQL_DATABASE=novel_app_db
# MYSQL_SSL_DISABLED=true
# MYSQL_INIT_SQL=setup_railway.sql
# MYSQL_FALLBACK_SQLITE=false

# UPLOAD_DIR=./uploads
# JWT_SECRET=change-me-in-production
# ADMIN_USERNAME=admin_Supun
# ADMIN_PASSWORD=change-me
# ADMIN_TOKEN_EXPIRES_HOURS=24
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=

# # Database auto-run on backend start (defaults are safe for local)
# AUTO_RUN_DB_MIGRATIONS=true
# AUTO_RUN_INKITT_SEED=true
# # ENABLE_INKITT_SEED=1
# # RUN_CONTENT_ENRICHMENT=1
# # FORCE_SQL_SCRIPTS=1
# # FORCE_SCHEMA_ENSURES=1


# backend/.env — copy to backend/.env and set MYSQL_PASSWORD / JWT_SECRET / ADMIN_PASSWORD

ENV=development
DEBUG=true
DB_TYPE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db
MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql
MYSQL_FALLBACK_SQLITE=false

UPLOAD_DIR=./uploads
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_EXPIRES_HOURS=24

# Google — Web client first; add Android client after the comma for Flutter
GOOGLE_CLIENT_ID=470949991659-kq78v41kdm7ut9ivie0ul634hgj8bgd7.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=470949991659-kq78v41kdm7ut9ivie0ul634hgj8bgd7.apps.googleusercontent.com,470949991659-avk11lvc5sv1ffietga62f8h591t7ijc.apps.googleusercontent.com

AUTO_RUN_DB_MIGRATIONS=true
AUTO_RUN_INKITT_SEED=true
