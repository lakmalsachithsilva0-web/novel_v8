# Default database = MySQL, database name = novel_app_db_v2
ENV=development
DEBUG=true
DB_TYPE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db_v2
MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql
MYSQL_FALLBACK_SQLITE=true

UPLOAD_DIR=./uploads
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_EXPIRES_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
